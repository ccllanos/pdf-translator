        },
        {
          "bbox": [
            105.59303283691406,
            235.8255615234375,
            206.74884033203125,
            255.1015625
          ],
          "translated_text": "Introducción",
          "font_name": "Fd63169",
          "font_size": 15.800000190734863
        },
        {
          "bbox": [
            66.24002838134766,
            265.5389709472656,
            92.74803161621094,
            291.57696533203125
          ],
          "translated_text": "Error",
          "font_name": "Fd385981",
