        },
        {
          "bbox": [
            105.60002899169922,
            270.20556640625,
            371.16961669921875,
            289.4815673828125
          ],
          "translated_text": "El Negro Ocupa el Espacio en el Cent",
          "font_name": "Fd63169",
          "font_size": 15.800000190734863
        },
        {
          "bbox": [
            66.24000549316406,
            299.6189880371094,
            92.74800872802734,
            325.656982421875
          ],
          "translated_text": "No tex",
          "font_name": "Fd385981",
          "font_size": 23.5
        },
        {
          "bbox": [
            105.84000396728516,
            304.28558349609375,
            338.5476379394531,
            323.56158447265625
          ],
          "translated_text": "Negro defiende el cuadrado dS",
          "font_name": "Fd63169",
          "font_size": 15.800000190734863
        },
        {
          "bbox": [
            66.01002502441406,
            333.72900390625,
            92.51802825927734,
            359.7669982910156
          ],
          "translated_text": "Error",
          "font_name": "Fd385981",
          "font_size": 23.5
        },
        {
          "bbox": [
            105.60002136230469,
            338.3356018066406,
            306.84661865234375,
            357.6116027832031
          ],
          "translated_text": "Copias Negras con S ... Nf6",
          "font_name": "Fd63169",
          "font_size": 15.800000190734863
        },
        {
          "bbox": [
            66.01101684570312,
            367.6290283203125,
            245.8865966796875,
            393.6670227050781
          ],
          "translated_text": "White Avoids Nf3",
